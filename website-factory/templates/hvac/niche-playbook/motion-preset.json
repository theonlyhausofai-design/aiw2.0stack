{
  "presetName": "restrained-professional",
  "description": "Calm, confident motion. Nothing bouncy or playful. Every animation earns its place.",
  "defaults": {
    "duration": 300,
    "durationUnit": "ms",
    "stagger": 80,
    "staggerUnit": "ms",
    "easing": "cubic-bezier(0.16, 1, 0.3, 1)",
    "easingName": "premium-out"
  },
  "heroEntrance": {
    "type": "fade-up",
    "duration": 400,
    "delay": 100,
    "easing": "cubic-bezier(0.16, 1, 0.3, 1)"
  },
  "trustStrip": {
    "type": "fade-in",
    "duration": 250,
    "delay": 0,
    "easing": "cubic-bezier(0.16, 1, 0.3, 1)"
  },
  "cards": {
    "type": "fade-up",
    "duration": 300,
    "stagger": 80,
    "easing": "cubic-bezier(0.16, 1, 0.3, 1)"
  },
  "sectionReveal": {
    "type": "fade-up",
    "duration": 350,
    "threshold": 0.15,
    "easing": "cubic-bezier(0.16, 1, 0.3, 1)"
  },
  "mobileOverrides": {
    "reducedMotion": true,
    "duration": 200,
    "stagger": 50
  },
  "rules": [
    "Never animate more than 3 elements at once on screen.",
    "No bounce or elastic easing.",
    "No parallax scrolling.",
    "No autoplay carousels. User-initiated only.",
    "Respect prefers-reduced-motion. Disable all animation when set."
  ]
}
