# =============================================================================
# AIW Resource Site environment
# Copy to .env.local for local dev, and set the same keys in Vercel for prod.
# The site runs WITHOUT any of these (it serves the baked snapshot and logs
# leads to the console). Add them to turn on live Drive sync + lead storage.
# =============================================================================

# --- Live Google Drive sync -------------------------------------------------
# Option A: service account (recommended for a deployed site).
#   1. Create a service account in Google Cloud, enable the Drive API.
#   2. Share the curated folders AND have thewebsitedept files shared into the
#      account the service account can read (or use domain-wide delegation +
#      GOOGLE_IMPERSONATE_EMAIL=theonlyhausofai@gmail.com).
#   3. Paste the JSON key below (raw JSON on one line, or base64-encoded).
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_IMPERSONATE_EMAIL=theonlyhausofai@gmail.com

# Option B: OAuth refresh token for theonlyhausofai@gmail.com.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=

# Optional: override the Drive queries that define the live catalog.
# JSON array of Drive query strings. Defaults to the HVAC library folder,
# its Niche_Expansions subfolder, and all files owned by thewebsitedept.
# DRIVE_QUERIES=["'FOLDER_ID' in parents and trashed = false"]

# --- Lead capture (Supabase) ------------------------------------------------
# Run supabase/migrations/0001_leads.sql against your project first.
# Provide EITHER the publishable/anon key (works via the insert-only RLS
# policy) OR the secret service-role key (bypasses RLS). The anon key is safe
# to expose; it can insert leads but never read them.
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
#
# Provisioned project for this site:
#   SUPABASE_URL=https://akbtkjakbjwnbtyddgnc.supabase.co
#   SUPABASE_ANON_KEY=<publishable/anon key from the Supabase dashboard>
